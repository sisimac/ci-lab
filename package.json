  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0"
  }
}
